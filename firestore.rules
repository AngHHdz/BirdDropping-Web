rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BirdDropping: reglas existentes conservadas.
    match /workspaces/{workspaceId}/files/{fileId} {
      allow read: if workspaceId.matches('^[A-Z0-9_-]{4,24}$');
      allow create: if workspaceId.matches('^[A-Z0-9_-]{4,24}$')
        && request.resource.data.codes is list
        && request.resource.data.codes.size() <= 2000;
      allow update, delete: if false;
    }

    // Colección separada para Carga de baterías GS.
    // El workspace es un identificador compartido, NO autenticación.
    match /batteryWorkspaces/{workspaceId}/records/{vin} {
      allow read: if workspaceId.matches('^[A-Z0-9_-]{4,24}$');
      allow create, update: if workspaceId.matches('^[A-Z0-9_-]{4,24}$')
        && vin.matches('^[A-HJ-NPR-Z0-9]{17}$')
        && request.resource.data.vin == vin
        && request.resource.data.opDate is string;
      allow delete: if false;
    }
  }
}